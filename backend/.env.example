# Copy to .env. Every value below has a working development default; production must set them.

ENV=dev                                   # dev | prod
DATABASE_URL=sqlite:///./samavesh.db      # or postgresql://user:pass@host/dbname
FRONTEND_ORIGIN=http://localhost:3210

# Signs session JWTs and verification codes. 32+ random characters in production:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Field-level encryption keys, "<id>:<base64 32-byte key>", comma-separated.
# The highest id encrypts; all ids decrypt, so add a new id to rotate.
#   python -c "import base64, os; print('1:' + base64.b64encode(os.urandom(32)).decode())"
DATA_ENCRYPTION_KEYS=

# Leave SMTP_HOST empty in development: emails go to the dev outbox (/dev/outbox) instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Samavesh <no-reply@example.com>

# Shared secret for the scheduled jobs endpoint.
JOBS_SECRET=
